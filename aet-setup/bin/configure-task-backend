#!/usr/bin/env bash
# Configure the aet-work task backend and ensure GitHub labels exist.
#
# Usage:
#   aet configure-backend [--backend json|github|git-refs] [--repo owner/repo]
#                         [--non-interactive] [--help]
#
# In interactive mode (default), the script prompts for the backend (empty
# input accepts the default, git-refs) and the repo. In non-interactive mode,
# a missing --backend selects the default (git-refs); other required values
# must be supplied via flags.

set -euo pipefail

BACKEND=""
REPO=""
NON_INTERACTIVE=0
PROJECT_ROOT="$(pwd)"
CONFIG_DIR="$PROJECT_ROOT/.agents"
CONFIG_FILE="$CONFIG_DIR/aet-work.json"

LABELS=(
  "aet:planned"
  "aet:ready"
  "aet:blocked"
  "aet:in-progress"
  "aet:awaiting-merge"
  "aet:merged"
  "aet:abandoned"
  "aet:failed"
)

usage() {
  cat <<EOF
Usage: aet configure-backend [options]

Configure the task backend for aet-work.

Options:
  --backend json|github|git-refs
                          Choose the task backend. Defaults to git-refs, the
                          recommended backend: live tasks are stored as local
                          git refs (refs/aet/tasks/*). json is the documented
                          opt-out for non-git or unconfigured contexts.
  --repo owner/repo       GitHub repository (required for github backend;
                          detected from git remote origin if omitted).
  --non-interactive       Fail if a required value is missing instead of prompting.
  --help                  Show this help message.

Examples:
  aet configure-backend --non-interactive
  aet configure-backend --backend json --non-interactive
  aet configure-backend --backend github --repo acme/widget --non-interactive
EOF
}

log() {
  echo "[$0] $*" >&2
}

error() {
  echo "Error: $*" >&2
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --backend)
      BACKEND="$2"
      shift 2
      ;;
    --repo)
      REPO="$2"
      shift 2
      ;;
    --non-interactive)
      NON_INTERACTIVE=1
      shift
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      error "Unknown option: $1"
      ;;
  esac
done

if [ -z "$BACKEND" ]; then
  if [ "$NON_INTERACTIVE" -eq 1 ]; then
    BACKEND="git-refs"
  else
    read -rp "Choose task backend (json, github, or git-refs) [git-refs]: " BACKEND
    BACKEND="${BACKEND:-git-refs}"
  fi
fi

case "$BACKEND" in
  json|github|git-refs) ;;
  *) error "Invalid backend '$BACKEND'. Choose 'json', 'github', or 'git-refs'." ;;
esac

mkdir -p "$CONFIG_DIR"

EXISTING_BACKEND=""
if [ -f "$CONFIG_FILE" ]; then
  EXISTING_BACKEND="$(python3 -c "import json,sys; print(json.load(open('$CONFIG_FILE')).get('task_backend',''))" 2>/dev/null || true)"
fi

SWITCH_WARNING=""
if [ -n "$EXISTING_BACKEND" ] && [ "$EXISTING_BACKEND" != "$BACKEND" ]; then
  SWITCH_WARNING="Switching from '$EXISTING_BACKEND' to '$BACKEND' is forward-only: active tasks and settled history are not migrated."
  log "WARNING: $SWITCH_WARNING"
fi

write_json_config() {
  python3 - "$@" <<'PY'
import json, sys
config = {}
if len(sys.argv) > 1 and sys.argv[1]:
    config = json.loads(sys.argv[1])
config["task_backend"] = sys.argv[2]
# Only populate github-specific keys when the github backend is selected.
if sys.argv[2] == "github":
    if len(sys.argv) > 3 and sys.argv[3]:
        config.setdefault("github", {})
        config["github"]["repo"] = sys.argv[3]
    if len(sys.argv) > 4 and sys.argv[4]:
        config.setdefault("github", {})
        config["github"]["label_prefix"] = sys.argv[4]
    if len(sys.argv) > 5 and sys.argv[5]:
        config.setdefault("github", {})
        config["github"]["labels_created"] = sys.argv[5] == "true"
    if len(sys.argv) > 6 and sys.argv[6]:
        config.setdefault("github", {})
        config["github"]["reason"] = sys.argv[6]
if len(sys.argv) > 7 and sys.argv[7]:
    config["switch_warning"] = sys.argv[7]
print(json.dumps(config, indent=2))
PY
}

LABEL_PREFIX="aet"
LABELS_CREATED="false"
REASON=""

if [ "$BACKEND" = "json" ]; then
  log "NOTE: json is the documented opt-out, appropriate for non-git or unconfigured contexts; git-refs is the default backend written by aet-setup."
fi

if [ "$BACKEND" = "github" ]; then
  if [ -z "$REPO" ]; then
    if git -C "$PROJECT_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      REMOTE_URL="$(git -C "$PROJECT_ROOT" remote get-url origin 2>/dev/null || true)"
      if [ -n "$REMOTE_URL" ]; then
        # Convert git@github.com:owner/repo.git or https://github.com/owner/repo.git to owner/repo
        REPO="$(echo "$REMOTE_URL" | sed -E 's#^(https://|git@)github.com[:/]##; s/\.git$//')"
      fi
    fi
  fi

  if [ -z "$REPO" ]; then
    if [ "$NON_INTERACTIVE" -eq 1 ]; then
      error "--repo is required in non-interactive mode when no git remote origin is available"
    fi
    read -rp "GitHub repository (owner/repo): " REPO
  fi

  if ! [[ "$REPO" =~ ^[^/]+/[^/]+$ ]]; then
    error "Invalid repository format '$REPO'. Expected owner/repo."
  fi

  if ! command -v gh >/dev/null 2>&1; then
    REASON="gh CLI not found. Install it and run 'gh auth login', then re-run this step."
    log "WARNING: $REASON"
  elif ! gh auth status >/dev/null 2>&1; then
    REASON="gh CLI is not authenticated. Run 'gh auth login' and re-run this step."
    log "WARNING: $REASON"
  else
    log "Ensuring AET labels exist in $REPO ..."
    LABELS_CREATED="true"
    for label in "${LABELS[@]}"; do
      COLOR="c2e0c6"
      DESCRIPTION="AET work state: ${label#aet:}"
      if gh label list --repo "$REPO" --search "$label" --json name | grep -q "\"$label\""; then
        log "  ✓ $label already exists"
      else
        if gh label create "$label" --repo "$REPO" --color "$COLOR" --description "$DESCRIPTION" >/dev/null 2>&1; then
          log "  ✓ Created $label"
        else
          LABELS_CREATED="false"
          REASON="Failed to create label '$label' in $REPO. Check permissions and re-run."
          log "WARNING: $REASON"
          break
        fi
      fi
    done
  fi
fi

EXISTING_JSON=""
if [ -f "$CONFIG_FILE" ]; then
  EXISTING_JSON="$(cat "$CONFIG_FILE")"
fi

write_json_config "$EXISTING_JSON" "$BACKEND" "$REPO" "$LABEL_PREFIX" "$LABELS_CREATED" "$REASON" "$SWITCH_WARNING" > "$CONFIG_FILE"

log "Wrote $CONFIG_FILE"
