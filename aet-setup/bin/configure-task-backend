#!/usr/bin/env bash
# Configure the aet-work task backend.
#
# Usage:
#   aet configure-backend [--backend json|git-refs] [--external-config]
#                         [--non-interactive] [--help]
#
# In interactive mode (default), the script prompts for the backend (empty
# input accepts the default, git-refs). In non-interactive mode, a missing
# --backend selects the default (git-refs).
#
# GitHub Issues is no longer a task_backend value; it is configured on the
# orthogonal "projections" axis in .agents/aet-work.json (see aet-setup docs).
#
# Use --external-config for a non-invasive project: the config is written to
# ~/.aet/{slug}/config.json and nothing is written inside the repo. Reads
# always resolve external-first: AET_WORK_CONFIG env → ~/.aet/{slug}/config.json
# → .agents/aet-work.json → defaults.

set -euo pipefail

BACKEND=""
NON_INTERACTIVE=0
EXTERNAL_CONFIG=0
PROJECT_ROOT="$(pwd)"
CONFIG_DIR="$PROJECT_ROOT/.agents"
CONFIG_FILE="$CONFIG_DIR/aet-work.json"

usage() {
  cat <<EOF
Usage: aet configure-backend [options]

Configure the task backend for aet-work.

Options:
  --backend json|git-refs
                          Choose the task backend. Defaults to git-refs, the
                          recommended backend: live tasks are stored as local
                          git refs (refs/aet/tasks/*). json is the documented
                          opt-out for non-git or unconfigured contexts.
  --external-config       Write config to ~/.aet/{slug}/config.json instead of
                          .agents/aet-work.json. Keeps AET config out of the
                          shared repo (non-invasive setup).
  --non-interactive       Fail if a required value is missing instead of prompting.
  --help                  Show this help message.

Examples:
  aet configure-backend --non-interactive
  aet configure-backend --backend json --non-interactive
  aet configure-backend --backend git-refs --external-config --non-interactive
EOF
}

log() {
  echo "[$0] $*" >&2
}

error() {
  echo "Error: $*" >&2
  exit 1
}

_bootstrap_pythonpath() {
  # After the lib extraction, configure-backend imports the installed aet
  # package. When run from a source checkout without the package installed in
  # the system python, prepend <repo-root>/src to PYTHONPATH.
  python3 -c "import aet" 2>/dev/null && return 0
  local script_dir repo_root
  script_dir="$(cd "$(dirname "$0")" && pwd)"
  repo_root="$(cd "$script_dir/../.." && pwd)"
  if [ -f "$repo_root/src/aet/__init__.py" ]; then
    export PYTHONPATH="$repo_root/src${PYTHONPATH:+:$PYTHONPATH}"
  fi
}

_bootstrap_pythonpath

derive_project_slug() {
  python3 - "$PROJECT_ROOT" <<'PY'
import sys
from aet.project_id import derive_project_slug
print(derive_project_slug(sys.argv[1] if len(sys.argv) > 1 else None))
PY
}

while [ $# -gt 0 ]; do
  case "$1" in
    --backend)
      BACKEND="$2"
      shift 2
      ;;
    --non-interactive)
      NON_INTERACTIVE=1
      shift
      ;;
    --external-config)
      EXTERNAL_CONFIG=1
      shift
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      error "Unknown option: $1"
      ;;
  esac
done

if [ -z "$BACKEND" ]; then
  if [ "$NON_INTERACTIVE" -eq 1 ]; then
    BACKEND="git-refs"
  else
    read -rp "Choose task backend (json or git-refs) [git-refs]: " BACKEND
    BACKEND="${BACKEND:-git-refs}"
  fi
fi

case "$BACKEND" in
  json|git-refs) ;;
  *) error "Invalid backend '$BACKEND'. Choose 'json' or 'git-refs'. GitHub Issues is configured on the 'projections' axis, not as a task_backend." ;;
esac

if [ "$EXTERNAL_CONFIG" -eq 1 ]; then
  SLUG="$(derive_project_slug)"
  EXTERNAL_CONFIG_DIR="$HOME/.aet/$SLUG"
  EXTERNAL_CONFIG_FILE="$EXTERNAL_CONFIG_DIR/config.json"
  mkdir -p "$EXTERNAL_CONFIG_DIR"
fi

EXISTING_BACKEND=""
if [ "$EXTERNAL_CONFIG" -eq 1 ] && [ -f "$EXTERNAL_CONFIG_FILE" ]; then
  EXISTING_BACKEND="$(python3 -c "import json,sys; print(json.load(open('$EXTERNAL_CONFIG_FILE')).get('task_backend',''))" 2>/dev/null || true)"
elif [ -f "$CONFIG_FILE" ]; then
  EXISTING_BACKEND="$(python3 -c "import json,sys; print(json.load(open('$CONFIG_FILE')).get('task_backend',''))" 2>/dev/null || true)"
fi

SWITCH_WARNING=""
if [ -n "$EXISTING_BACKEND" ] && [ "$EXISTING_BACKEND" != "$BACKEND" ]; then
  SWITCH_WARNING="Switching from '$EXISTING_BACKEND' to '$BACKEND' is forward-only: active tasks and settled history are not migrated."
  log "WARNING: $SWITCH_WARNING"
fi

write_json_config() {
  python3 - "$@" <<'PY'
import json, sys
config = {}
if len(sys.argv) > 1 and sys.argv[1]:
    config = json.loads(sys.argv[1])
config["task_backend"] = sys.argv[2]
if len(sys.argv) > 3 and sys.argv[3]:
    config["switch_warning"] = sys.argv[3]
print(json.dumps(config, indent=2))
PY
}

if [ "$BACKEND" = "json" ]; then
  log "NOTE: json is the documented opt-out, appropriate for non-git or unconfigured contexts; git-refs is the default backend written by aet-setup."
fi

if [ "$EXTERNAL_CONFIG" -eq 1 ]; then
  EXISTING_JSON=""
  if [ -f "$EXTERNAL_CONFIG_FILE" ]; then
    EXISTING_JSON="$(cat "$EXTERNAL_CONFIG_FILE")"
  fi

  write_json_config "$EXISTING_JSON" "$BACKEND" "$SWITCH_WARNING" > "$EXTERNAL_CONFIG_FILE"

  log "Wrote external config to $EXTERNAL_CONFIG_FILE"
  log "Config resolution order: AET_WORK_CONFIG env → ~/.aet/{slug}/config.json → .agents/aet-work.json → defaults"
else
  mkdir -p "$CONFIG_DIR"

  EXISTING_JSON=""
  if [ -f "$CONFIG_FILE" ]; then
    EXISTING_JSON="$(cat "$CONFIG_FILE")"
  fi

  write_json_config "$EXISTING_JSON" "$BACKEND" "$SWITCH_WARNING" > "$CONFIG_FILE"

  log "Wrote $CONFIG_FILE"
fi
