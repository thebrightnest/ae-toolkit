#!/usr/bin/env python3
"""aet-work status — Show the current state of the work queue.

Checks plan drift against the active queue and the settled history log, reads
the stored state, and reports counts, next tasks, failed tasks, and worktree health.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

_SCRIPT_DIR = Path(__file__).resolve().parent
_LIB_DIR = _SCRIPT_DIR.parent / "lib"
sys.path.insert(0, str(_LIB_DIR))

from queue import current_state, state_to_status  # noqa: E402

from backends.factory import create_backend  # noqa: E402


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Show work queue status.")
    parser.add_argument(
        "--queue-file",
        default=".agents/work-queue.json",
        help="Path to work-queue.json",
    )
    parser.add_argument(
        "--history-file",
        default=".agents/work-history.jsonl",
        help="Path to work-history.jsonl",
    )
    parser.add_argument(
        "--plans-dir",
        default="docs/plans",
        help="Directory containing atomic plan markdown files",
    )
    return parser.parse_args()


def _display_category(task: dict) -> str:
    """Return the human-readable category for a task's stored state."""
    return state_to_status(current_state(task))


def main() -> int:
    args = parse_args()
    backend = create_backend(
        queue_file=args.queue_file, history_file=args.history_file
    )
    data = backend.load()
    queue = data["queue"]
    plans_dir = Path(args.plans_dir)

    orphaned = backend.plan_drift(plans_dir)

    if orphaned:
        print(f"⚠️ Plan drift detected: {len(orphaned)} plan file(s) not in queue")
        for pf in orphaned:
            print(f"  - {pf}")
        print("Run init-queue to sync if you want these plans tracked.")
    else:
        print("✅ No plan drift detected. All plans are tracked in the queue.")

    counts = {"planned": 0, "unblocked": 0, "blocked": 0, "in-progress": 0, "awaiting_merge": 0, "failed": 0, "done": 0}
    for task in queue:
        category = _display_category(task)
        if category in counts:
            counts[category] += 1

    print("\nQueue summary (active tasks only):")
    for status, count in counts.items():
        print(f"  {status}: {count}")

    terminal = {"merged", "abandoned"}
    print(f"\n{'ID':<40} {'State':<20}")
    print("-" * 60)
    for task in queue:
        if current_state(task) in terminal:
            continue
        task_id = task.get("id", "")
        state = current_state(task) or "unknown"
        print(f"{task_id:<40} {state:<20}")

    ready = [t for t in queue if current_state(t) == "ready"]
    print("\nNext ready tasks:")
    if ready:
        for task in ready[:3]:
            print(f"  - {task.get('id')} — {task.get('title')} → {task.get('plan_file')}")
    else:
        print("  None.")

    failed = [t for t in queue if current_state(t) == "failed"]
    print("\nFailed tasks:")
    if failed:
        for task in failed:
            print(f"  - {task.get('id')} — {task.get('title')}")
    else:
        print("  None.")

    print("\nWorktree validation:")
    stale = 0
    for task in queue:
        worktree = task.get("worktree")
        if worktree and not Path(worktree).is_dir():
            print(
                f"  ⚠️ Stale worktree: {task.get('id')} → {worktree} does not exist."
            )
            stale += 1
    if not stale:
        print("  All registered worktrees present.")

    return 0


if __name__ == "__main__":
    sys.exit(main())
