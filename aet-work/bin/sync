#!/usr/bin/env python3
"""aet-work sync — Append-only sync of docs/plans/*.md into the work queue.

Loads the existing queue and settled history log, appends only newly created
plan files, validates the frontmatter contract and atomicity, recomputes the
dependency DAG, reports drift, and updates wrapper metadata. It does **not**
derive status or promote tasks.
"""

from __future__ import annotations

import argparse
import sys
from datetime import datetime
from pathlib import Path

# Load shared libraries.
_SCRIPT_DIR = Path(__file__).resolve().parent
_LIB_DIR = _SCRIPT_DIR.parent / "lib"
sys.path.insert(0, str(_LIB_DIR))

from plan_parser import (  # noqa: E402
    intake_validation_errors,
    new_task_from_plan,
    validate_size,
)
from queue import read_history, read_queue, write_queue  # noqa: E402


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Sync docs/plans into the work queue.")
    parser.add_argument(
        "--queue-file",
        default=".agents/work-queue.json",
        help="Path to work-queue.json",
    )
    parser.add_argument(
        "--history-file",
        default=".agents/work-history.jsonl",
        help="Path to work-history.jsonl",
    )
    parser.add_argument(
        "--plans-dir",
        default="docs/plans",
        help="Directory containing atomic plan markdown files",
    )
    return parser.parse_args()


def build_blocks(queue: list[dict]) -> None:
    """Recompute ``blocks`` as the inverse of ``blocked_by`` for the whole queue."""
    task_by_id = {t["id"]: t for t in queue if t.get("id")}
    for task in queue:
        task["blocks"] = []
    for task in queue:
        for blocker in task.get("blocked_by", []):
            if blocker in task_by_id:
                task_by_id[blocker].setdefault("blocks", []).append(task["id"])


def main() -> int:
    args = parse_args()
    queue_file = args.queue_file
    history_file = args.history_file
    plans_dir = Path(args.plans_dir)

    queue = read_queue(queue_file)
    history = read_history(history_file)

    existing_by_file = {t.get("plan_file"): t for t in queue if t.get("plan_file")}
    settled_files = {t.get("plan_file") for t in history if t.get("plan_file")}
    settled_ids = {t.get("id") for t in history if t.get("id")}

    plan_files = sorted(plans_dir.glob("*.md"))

    # Sync is append-only: only candidate plans (not already queued or settled)
    # need to pass intake validation. Every plan is still parsed so that blocker
    # references resolve against the full corpus.
    candidate_files = {
        pf
        for pf in plan_files
        if str(pf) not in existing_by_file
        and str(pf) not in settled_files
        and pf.stem not in settled_ids
    }
    errors = intake_validation_errors(plan_files, limit_to=candidate_files)
    if errors:
        for pf, reason in errors:
            print(f"❌ {pf.name}: {reason}", file=sys.stderr)
        return 1

    added = 0
    preserved = 0
    skipped_settled = 0
    skipped_size = 0
    new_tasks: list[dict] = []

    for pf in plan_files:
        pf_str = str(pf)

        if pf_str in existing_by_file:
            new_tasks.append(existing_by_file[pf_str])
            preserved += 1
            continue

        task_id = pf.stem
        if task_id in settled_ids or pf_str in settled_files:
            skipped_settled += 1
            continue

        ok, reason, oversized = validate_size(pf)
        if not ok and not oversized:
            # Defensive: validation above should already catch this.
            print(
                f"⚠️ Skipping {pf.name}: exceeds complexity limit ({reason}). Split the plan.",
                file=sys.stderr,
            )
            skipped_size += 1
            continue

        task = new_task_from_plan(pf, status="planned")
        if oversized:
            task["oversized"] = True
        new_tasks.append(task)
        added += 1

    # Rebuild the queue in plan-file order, preserving existing entries.
    final_queue: list[dict] = []
    seen_files = set()
    for task in queue:
        pf = task.get("plan_file")
        final_queue.append(task)
        if pf:
            seen_files.add(pf)
    for task in new_tasks:
        pf = task.get("plan_file")
        if pf and pf not in seen_files:
            final_queue.append(task)
            seen_files.add(pf)

    # Normalize legacy statuses.
    for task in final_queue:
        if task.get("status") == "merge_verified":
            task["status"] = "merged"

    build_blocks(final_queue)

    # Report plan drift without mutating stored status.
    plan_file_set = {str(pf) for pf in plan_files}
    drifted = 0
    for task in final_queue:
        pf = task.get("plan_file")
        if pf and pf not in plan_file_set:
            drifted += 1
            print(f"⚠️ Drift: {task.get('id')} -> {pf}")

    write_queue(
        queue_file,
        final_queue,
        wrapper={"queue_updated_at": datetime.now().isoformat()},
    )

    print(
        f"\n✅ Sync complete: {added} new tasks added, {preserved} existing tasks preserved, "
        f"{skipped_settled} skipped (already settled), {skipped_size} skipped (size), "
        f"{drifted} drifted tasks reported."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
