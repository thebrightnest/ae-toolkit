#!/usr/bin/env python3
"""ingest-telemetry — Archive project telemetry for cross-project learning."""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

DEFAULT_ARCHIVE_DIR = Path.home() / ".aet" / "telemetry"
DEFAULT_REPORTS_DIR = Path("/tmp/aet-reports")


def iso_now() -> str:
    """Return the current UTC time as an ISO-8601 string."""
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def resolve_repo_root(repo_root: Path | None = None) -> Path:
    """Resolve the repository root from args, env, git, or cwd."""
    if repo_root is not None:
        return repo_root

    env_root = os.environ.get("AET_REPO_ROOT")
    if env_root:
        return Path(env_root).resolve()

    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode == 0:
            return Path(result.stdout.strip()).resolve()
    except FileNotFoundError:
        pass

    return Path.cwd().resolve()


def derive_repo_slug(repo_root: Path) -> str:
    """Derive owner/repo slug from the origin remote or directory name."""
    env_slug = os.environ.get("AET_REPO_SLUG")
    if env_slug:
        return env_slug

    try:
        result = subprocess.run(
            ["git", "remote", "get-url", "origin"],
            cwd=repo_root,
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode == 0:
            url = result.stdout.strip()
            if url.endswith(".git"):
                url = url[:-4]
            if ":" in url and "//" not in url:
                url = url.split(":", 1)[-1]
            parts = url.rstrip("/").split("/")
            return "/".join(parts[-2:])
    except FileNotFoundError:
        pass

    return repo_root.name


def sanitize(text: str, repo_roots: list[Path]) -> str:
    """Replace absolute repository and home paths with placeholders."""
    for repo_root in repo_roots:
        root = str(repo_root)
        text = re.sub(re.escape(root), "{REPO_ROOT}", text)
    home = str(Path.home())
    text = re.sub(re.escape(home), "{HOME}", text)
    return text


def archive_file(
    source: Path,
    dest: Path,
    run_dir: Path,
    repo_roots: list[Path],
    project_id: str,
    repo_slug: str,
) -> dict[str, Any]:
    """Copy a source file into the archive with sanitized paths and metadata."""
    dest.parent.mkdir(parents=True, exist_ok=True)
    content = source.read_text(encoding="utf-8")
    sanitized = sanitize(content, repo_roots)

    if source.suffix == ".md":
        header = (
            f"---\n"
            f"project_id: {project_id}\n"
            f"repo_slug: {repo_slug}\n"
            f"archived_at: {iso_now()}\n"
            f"---\n\n"
        )
        dest.write_text(header + sanitized, encoding="utf-8")
    else:
        dest.write_text(sanitized, encoding="utf-8")

    return {
        "source": str(source),
        "dest": str(dest.relative_to(run_dir)),
        "type": "markdown" if source.suffix == ".md" else "jsonl",
    }


def ingest(
    run_id: str | None = None,
    project_id: str | None = None,
    repo_slug: str | None = None,
    repo_root: Path | None = None,
    archive_dir: Path | None = None,
    reports_dir: Path | None = None,
    date: str | None = None,
) -> Path:
    """Archive telemetry sources for a single run."""
    repo_root = resolve_repo_root(repo_root)
    project_id = project_id or os.environ.get("AET_PROJECT_ID") or repo_root.name
    repo_slug = repo_slug or derive_repo_slug(repo_root)
    run_id = run_id or os.environ.get("AET_RUN_ID") or str(uuid.uuid4())
    date = date or datetime.now(timezone.utc).strftime("%Y-%m-%d")
    archive_dir = (
        archive_dir
        or Path(os.environ.get("AET_TELEMETRY_ARCHIVE_DIR") or DEFAULT_ARCHIVE_DIR)
    ).expanduser()
    reports_dir = (
        reports_dir
        or Path(os.environ.get("AET_REPORTS_DIR") or DEFAULT_REPORTS_DIR)
    ).expanduser()
    archived_at = iso_now()

    run_dir = archive_dir / project_id / f"{date}-{run_id}"
    run_dir.mkdir(parents=True, exist_ok=True)

    files: list[dict[str, Any]] = []

    sources = [
        repo_root / ".agents" / "execution.log.jsonl",
        repo_root / ".agents" / "work-history.jsonl",
    ]

    repo_roots = [repo_root, repo_root.resolve()]

    for source in sources:
        if source.exists():
            dest = run_dir / source.name
            files.append(
                archive_file(source, dest, run_dir, repo_roots, project_id, repo_slug)
            )

    if reports_dir.exists():
        for report in sorted(reports_dir.glob("*/*.md")):
            dest = run_dir / report.parent.name / report.name
            files.append(
                archive_file(report, dest, run_dir, repo_roots, project_id, repo_slug)
            )

    manifest = {
        "project_id": project_id,
        "repo_slug": repo_slug,
        "run_id": run_id,
        "archived_at": archived_at,
        "repo_root_placeholder": "{REPO_ROOT}",
        "files": files,
    }
    (run_dir / "manifest.json").write_text(
        json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
    )

    return run_dir


def main(argv: list[str] | None = None) -> int:
    """CLI entry point."""
    parser = argparse.ArgumentParser(
        description="Archive project telemetry for cross-project learning."
    )
    parser.add_argument("--run-id", default=None, help="Run identifier.")
    parser.add_argument("--project-id", default=None, help="Project identifier.")
    parser.add_argument(
        "--repo-slug", default=None, help="Repository slug (owner/repo)."
    )
    parser.add_argument(
        "--repo-root", type=Path, default=None, help="Path to repository root."
    )
    parser.add_argument(
        "--archive-dir", type=Path, default=None, help="Telemetry archive root."
    )
    parser.add_argument(
        "--reports-dir", type=Path, default=None, help="Reports directory."
    )
    parser.add_argument("--date", default=None, help="Archive date (YYYY-MM-DD).")
    args = parser.parse_args(argv)

    run_dir = ingest(
        run_id=args.run_id,
        project_id=args.project_id,
        repo_slug=args.repo_slug,
        repo_root=args.repo_root,
        archive_dir=args.archive_dir,
        reports_dir=args.reports_dir,
        date=args.date,
    )
    print(run_dir)
    return 0


if __name__ == "__main__":
    sys.exit(main())
