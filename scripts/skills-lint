#!/usr/bin/env python3
"""skills-lint — validate documented `aet` invocations against the real tree.

Reads `aet` command lines from code spans in skill/scaffolding markdown and
validates them against the same sources of truth the dispatcher executes:
`src/aet/cli/main.py`'s SUBCOMMANDS spec and each target binary's build_parser().

Rule 1 (error): unknown `aet` subcommand, or unknown flag for its target parser.
Rule 2 (legacy): command-position legacy names (`aet-work`, `aet-state`, ...)
    or `aet-*/bin/...` path invocations — severity via --legacy=warn|error.

Escape: `<!-- aet-lint: off -->` ... `<!-- aet-lint: on -->` exempts spans.

Usage:
    skills-lint [--legacy=warn|error] [files...]

With no files, lints the default repo set: skills/**/*.md,
.agents/templates/*.md, .agents/commands/*.md, and AGENTS.md.
Exits 0 when there are no errors (warnings allowed), 1 otherwise.
"""

from __future__ import annotations

import argparse
import glob
import re
import shlex
import sys
from pathlib import Path

import click
import typer

REPO_ROOT = Path(__file__).resolve().parent.parent

# Fenced code block info strings whose contents are shell command lines.
SHELL_LANGS = {"", "bash", "sh", "console"}

# Legacy command-position names replaced by `aet <subcommand>` (cli-01).
LEGACY_NAMES = {
    "aet-work",
    "aet-state",
    "orchestrator",
    "aet-retro",
    "mine-learnings",
    "configure-task-backend",
    "install-aet-binaries",
}

# Path invocation of a skill binary, e.g. ./aet-work/bin/orchestrator.
LEGACY_PATH_RE = re.compile(r"(?:^|/)aet-[^/]+/bin/")

# Opaque documentation tokens that pass as values without further checks.
OPAQUE_RE = re.compile(r"^(<.*>|\{.*\}|\.\.\.|…|\$.*)$")

# Split a shell line into command segments (pipeline / list separators).
SEGMENT_RE = re.compile(r"\s*(?:&&|\|\||[;|])\s*")

INLINE_CODE_RE = re.compile(r"(`+)([^`\n]+?)\1")

FENCE_OPEN_RE = re.compile(r"^```\s*(\S*)")


def load_app():
    """Load the consolidated Click group from src/aet/cli/main.py."""
    # Ensure the local package is importable when the script is run directly.
    src_dir = str(REPO_ROOT / "src")
    if src_dir not in sys.path:
        sys.path.insert(0, src_dir)
    import typer as _typer

    from aet.cli.main import app as typer_app

    return _typer.main.get_group(typer_app)


def _click_group_grammar(group):
    """Return (flags, choices) for a Click/Typer group.

    flags: option strings declared on the group itself (e.g. callback options).
    choices: names of commands registered directly on the group.
    """
    flags: set[str] = set()
    for param in group.params:
        if hasattr(param, "opts"):
            flags.update(param.opts)
    choices = set(group.commands.keys())
    return flags, choices


def _click_command_grammar(command):
    """Return option strings declared on a Click/Typer command."""
    flags: set[str] = set()
    for param in command.params:
        if hasattr(param, "opts"):
            flags.update(param.opts)
    return flags


def build_grammars(app):
    """Map each reachable command path to (flags, choices).

    Paths are tuples of command names starting from the top-level app, e.g.
    ('gate',) for the gate group, ('gate', 'review') for the review command.
    For groups, choices are the names of subcommands. For commands, choices
    is empty.
    """
    grammars: dict[tuple[str, ...], tuple[set[str], set[str]]] = {}

    def walk(group, path: tuple[str, ...]):
        flags, choices = _click_group_grammar(group)
        grammars[path] = (flags, choices)
        for name, command in group.commands.items():
            child_path = path + (name,)
            if isinstance(command, (click.core.Group, typer.core.TyperGroup)):
                walk(command, child_path)
            else:
                grammars[child_path] = (_click_command_grammar(command), set())

    walk(app, ())
    return grammars


def is_opaque(token: str) -> bool:
    return bool(OPAQUE_RE.match(token))


def is_flag_token(token: str) -> bool:
    """A token that must be a known flag: -x/--xxx, excluding negatives."""
    if not token.startswith("-") or token == "-":
        return False
    return not token[1].isdigit()


def extract_spans(text: str):
    """Yield (line_no, content) shell code spans from markdown text.

    Code spans only: fenced blocks (bash/sh/console/unlabeled) and inline
    backtick spans. Spans between aet-lint escape markers are exempt.
    """
    lines = text.splitlines()
    active = []  # (line_no, text) of lines not escaped by lint markers
    lint_on = True
    for i, line in enumerate(lines, start=1):
        markers = re.findall(r"<!-- aet-lint: (off|on) -->", line)
        if markers:
            # Marker lines are never linted; the last marker sets the state.
            lint_on = markers[-1] == "on"
            continue
        if lint_on:
            active.append((i, line))

    spans = []
    consumed: set[int] = set()
    i = 0
    while i < len(active):
        line_no, line = active[i]
        open_match = FENCE_OPEN_RE.match(line.strip())
        if open_match:
            lang = open_match.group(1)
            body = []
            j = i + 1
            while j < len(active):
                _, inner = active[j]
                if inner.strip().startswith("```"):
                    break
                body.append(active[j])
                j += 1
            consumed.update(n for n, _ in active[i : j + 1])
            if lang in SHELL_LANGS:
                spans.extend(body)
            i = j + 1
        else:
            i += 1

    for line_no, line in active:
        if line_no in consumed:
            continue
        for match in INLINE_CODE_RE.finditer(line):
            spans.append((line_no, match.group(2)))
    return spans


def command_segments(line: str):
    """Split a shell line into token lists, one per command position."""
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        return []
    if stripped.startswith(("$ ", "% ", "> ")):
        stripped = stripped[2:]
    segments = []
    for segment in SEGMENT_RE.split(stripped):
        segment = segment.strip()
        if not segment:
            continue
        try:
            tokens = shlex.split(segment)
        except ValueError:
            continue
        if tokens:
            segments.append(tokens)
    return segments


# Subcommands whose first positional argument may be a plan/file path when it
# is not a known subcommand (e.g. `aet ship <plan_file>` runs gate + open).
_DEFAULT_PATH_SUBCOMMANDS = {"ship"}


def _resolve_path(args: list[str], grammars: dict) -> tuple[tuple[str, ...], list[str]]:
    """Resolve as much of args as a command-path walk; return (path, remainder).

    Starting from the top-level group (path ()), consume tokens that name known
    subcommands. Stop at the first token that is not a known subcommand of the
    current group. The remainder are flags/arguments for the resolved command.
    """
    path: tuple[str, ...] = ()
    current_flags, current_choices = grammars.get(path, (set(), set()))
    i = 0
    while i < len(args):
        token = args[i]
        if is_opaque(token):
            i += 1
            continue
        if token in current_choices:
            path = path + (token,)
            current_flags, current_choices = grammars.get(path, (set(), set()))
            i += 1
        else:
            break
    return path, args[i:]


def validate_aet_args(args, grammars):
    """Validate the argv after `aet`; return list of error strings."""
    if not args:
        return []
    head = args[0]
    if is_opaque(head):
        return []

    top_flags, top_choices = grammars.get((), (set(), set()))
    if head not in top_choices:
        return [f"unknown aet subcommand '{head}'"]

    path, remainder = _resolve_path(args, grammars)
    flags, choices = grammars.get(path, (set(), set()))
    errors = []
    checked_choice = False
    for token in remainder:
        if is_opaque(token):
            continue
        if is_flag_token(token):
            flag = token.split("=", 1)[0]
            if flag not in flags:
                errors.append(f"unknown flag '{flag}' for 'aet {' '.join(path)}'".strip())
        elif choices and not checked_choice:
            checked_choice = True
            if token not in choices:
                if path and path[0] in _DEFAULT_PATH_SUBCOMMANDS and len(path) == 1:
                    # First positional argument under a default-path group is
                    # treated as the default plan file path.
                    continue
                errors.append(f"unknown subcommand '{token}' for 'aet {' '.join(path)}'".strip())
    return errors


def validate_tokens(tokens, grammars, legacy_mode):
    """Validate one command-position token stream; return (severity, msg) list."""
    findings = []
    head = tokens[0]
    basename = head.rsplit("/", 1)[-1]

    if head == "aet" or basename == "aet":
        for msg in validate_aet_args(tokens[1:], grammars):
            findings.append(("error", msg))
        return findings

    if head in LEGACY_NAMES:
        findings.append(
            (legacy_mode, f"legacy command '{head}' — use 'aet <subcommand>'")
        )
    elif ":" not in head and LEGACY_PATH_RE.search(head):
        findings.append(
            (legacy_mode, f"legacy binary path '{head}' — use 'aet <subcommand>'")
        )
    return findings


def lint_file(path: Path, grammars, legacy_mode):
    """Lint one markdown file; return (line_no, severity, message) findings."""
    findings = []
    text = path.read_text(encoding="utf-8")
    for line_no, span in extract_spans(text):
        for tokens in command_segments(span):
            for severity, msg in validate_tokens(tokens, grammars, legacy_mode):
                findings.append((line_no, severity, msg))
    return findings


def default_files():
    """Repo-root-anchored default lint set."""
    paths = []
    for pattern in (
        "skills/**/*.md",
        ".agents/templates/*.md",
        ".agents/commands/*.md",
    ):
        paths.extend(glob.glob(pattern, root_dir=REPO_ROOT, recursive=True))
    paths.append("AGENTS.md")
    return sorted(REPO_ROOT / p for p in paths)


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="skills-lint", description=__doc__)
    parser.add_argument(
        "--legacy",
        choices=("warn", "error"),
        default="warn",
        help="severity of legacy-name references (default: warn)",
    )
    parser.add_argument("files", nargs="*", help="markdown files to lint")
    args = parser.parse_args(argv)

    legacy_mode = "warning" if args.legacy == "warn" else "error"
    app = load_app()
    grammars = build_grammars(app)

    files = [Path(f) for f in args.files] if args.files else default_files()
    errors = 0
    warnings = 0
    for path in files:
        for line_no, severity, msg in lint_file(path, grammars, legacy_mode):
            print(f"{path}:{line_no}: {severity}: {msg}")
            if severity == "error":
                errors += 1
            else:
                warnings += 1

    print(
        f"skills-lint: {len(files)} files, {errors} errors, {warnings} warnings"
    )
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
